{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{src/resilience/web/**,docs/assets/**,config/m22_manipulated_variables.csv}",
      "excludeFiles": "{tests/**,.local/**,.venv/**,artifacts/**,review-input/**,docs/client/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
